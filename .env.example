# Pulse Backend — Environment Template
# Copy sang backend/.env và điền giá trị thật. KHÔNG commit .env vào git.

# PostgreSQL (local machine, user postgres)
DATABASE_URL="postgresql://postgres@localhost:5432/pulse_social?schema=public"

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Auth secrets — BẮT BUỘC (xem SEC-03: backend fail-fast khi thiếu).
# Sinh bằng: openssl rand -base64 48
JWT_SECRET=
COOKIE_SECRET=

# Web Push VAPID — dùng chung giữa các lần restart để không mất subscription (xem SEC-04).
# Sinh bằng: node scripts/generate-vapid-keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
